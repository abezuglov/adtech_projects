# Data. The synthetic pipeline's own working data (data/interim/synthetic_world.json,
# etc.) regenerates locally via scripts/generate_synthetic_world.py +
# scripts/generate_synthetic_scenarios.py, so isn't committed either.
# data/raw/ and data/processed/ predate this repo's synthetic-first-price
# state (real iPinYou logs from the archive/real-data-gsp branch's
# pipeline) -- still ignored so any of that multi-GB data left on disk
# locally never gets swept into a commit by accident.
data/raw/
data/interim/
data/processed/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.ipynb_checkpoints/

# Env / secrets
.env
*.local

# OS
.DS_Store
Thumbs.db

# Model artifacts (regenerate via scripts, do not commit large binaries)
*.pkl
*.joblib
!reports/figures/*

# Large regenerated trajectory-dump reports (9-16MB+, one run per regenerate;
# regenerate via scripts/run_synthetic_bandit.py / run_scenario_grid.py).
# Small summary reports (e.g. naive-baseline results, no trajectory data)
# stay tracked.
reports/synthetic_bandit_results*.json
reports/synthetic_scenario_grid_results*.json
